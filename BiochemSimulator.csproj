<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>BiochemSimulator</AssemblyName>
    <RootNamespace>BiochemSimulator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Portable simulation core (engine + models). All chemistry/biology
         logic lives here and builds on any OS; this WPF project is only the
         Windows presentation layer on top of it. -->
    <ProjectReference Include="BiochemSimulator.Core\BiochemSimulator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- These folders are separate projects; exclude them from this project's
         default source globbing. -->
    <Compile Remove="BiochemSimulator.Core\**" />
    <EmbeddedResource Remove="BiochemSimulator.Core\**" />
    <None Remove="BiochemSimulator.Core\**" />
    <Page Remove="BiochemSimulator.Core\**" />
    <Compile Remove="BiochemSimulator.Tests\**" />
    <EmbeddedResource Remove="BiochemSimulator.Tests\**" />
    <None Remove="BiochemSimulator.Tests\**" />
    <Page Remove="BiochemSimulator.Tests\**" />
  </ItemGroup>

</Project>
